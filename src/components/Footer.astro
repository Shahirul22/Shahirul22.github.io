---
import { site } from '../lib/site';
const year = new Date().getFullYear();
---
<footer class="mt-24 border-t border-ink-200 dark:border-ink-800">
  <div class="container-prose py-10 flex flex-col md:flex-row items-center justify-between gap-4 font-mono text-xs sm:text-sm">
    <p class="text-ink-500 dark:text-ink-400">
      <span class="text-terminal-green">➜</span> <span class="text-accent">~</span> exit
      <span class="ml-2 text-ink-400 dark:text-ink-600">// session closed {year}, built with Astro, React &amp; Tailwind</span>
    </p>
    <div class="flex items-center gap-4 text-ink-500 dark:text-ink-400">
      <a href={`mailto:${site.email}`} class="hover:text-accent transition-colors">{site.email}</a>
      <span class="text-ink-300 dark:text-ink-700">|</span>
      <a href={site.github} target="_blank" rel="noreferrer" class="hover:text-accent transition-colors">GitHub</a>
    </div>
  </div>
</footer>
