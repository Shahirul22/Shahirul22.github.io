---
import { experiences } from '../lib/data';
---
<div class="terminal overflow-hidden">
  <div class="terminal-header">
    <span class="terminal-dot bg-terminal-red"></span>
    <span class="terminal-dot bg-terminal-amber"></span>
    <span class="terminal-dot bg-terminal-green"></span>
    <span class="ml-2 font-mono text-xs text-ink-500 dark:text-ink-400">
      git log --stat — shahirul@career
    </span>
  </div>

  <div class="p-4 sm:p-6">
    <ol class="relative border-l border-ink-200 dark:border-ink-800 ml-2 space-y-8">
      {experiences.map((exp, i) => (
        <li class="pl-6 reveal" style={`transition-delay:${i * 100}ms`}>
          <span
            class="absolute -left-[5px] mt-1.5 w-[9px] h-[9px] rounded-full bg-accent border-2 border-ink-50 dark:border-ink-950"
            aria-hidden="true"
          ></span>

          <div class="font-mono text-xs text-ink-400 dark:text-ink-500 mb-1">
            commit <span class="text-accent">{exp.company.toLowerCase().replace(/[^a-z0-9]+/g, '').slice(0, 7).padEnd(7, '0')}</span>
          </div>

          <div class="flex flex-wrap items-baseline justify-between gap-x-3 gap-y-1">
            <h3 class="text-lg font-bold text-ink-900 dark:text-ink-50">
              {exp.role} <span class="text-accent font-mono text-base font-normal">@ {exp.company}</span>
            </h3>
            <span class="font-mono text-xs text-ink-500 dark:text-ink-400">{exp.period}</span>
          </div>

          {exp.location && (
            <p class="font-mono text-xs text-ink-400 dark:text-ink-500 mt-0.5 mb-3">{exp.location}</p>
          )}

          <ul class="space-y-1.5 text-sm text-ink-700 dark:text-ink-300">
            {exp.bullets.map((b) => (
              <li class="flex gap-2">
                <span class="text-terminal-green font-mono shrink-0">+</span>
                <span>{b}</span>
              </li>
            ))}
          </ul>

          <div class="mt-3 flex flex-wrap gap-1.5">
            {exp.tags.map((t) => <span class="badge">{t}</span>)}
          </div>
        </li>
      ))}
    </ol>
  </div>
</div>
